# See OSINT - Environment Variables
# Copy this file to .env and fill in your API keys
# Never commit .env files to version control!

# API Keys
# Get NumVerify key at: https://numverify.com/
SEE_NUMVERIFY_KEY=

# Get Abstract API key at: https://www.abstractapi.com/api/phone-validation
SEE_ABSTRACT_KEY=

# Get NumLookupAPI key at: https://numlookupapi.com/
SEE_NUMLOOKUP_KEY=

# Get Hunter.io key at: https://hunter.io/api-keys
SEE_HUNTER_KEY=

# Get DeHashed key at: https://dehashed.com/api
SEE_DEHASHED_KEY=

# Get OpenCellID key at: https://opencellid.org/
SEE_OPENCELLID_KEY=

# Tor Configuration (optional)
SEE_TOR_ENABLED=false
SEE_TOR_SOCKS_PORT=9050
SEE_TOR_CONTROL_PORT=9051

# Output (optional)
SEE_OUTPUT_DIR=./results
